# ---- wallet (REQUIRED for live) ----
# Base58 secret key or JSON byte array. Read once, removed from process.env, never logged.
# Use a dedicated hot wallet holding only what you're willing to lose.
SOLANA_PRIVATE_KEY=

# live (default) or paper
MODE=live

# A paid RPC (Helius/Triton/QuickNode) is strongly recommended; the public one rate-limits.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Birdeye key enables new-listing discovery + holder counts
BIRDEYE_API_KEY=
# Optional: Jupiter API key (then set JUPITER_BASE_URL=https://api.jup.ag/swap/v1)
JUPITER_API_KEY=
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1

# Optional: Telegram alerts + remote control (token from @BotFather). Or paste it in the dashboard.
TELEGRAM_BOT_TOKEN=

# Dashboard. Keep 127.0.0.1 unless you set DASHBOARD_TOKEN.
HOST=127.0.0.1
PORT=8787
DASHBOARD_TOKEN=

PAPER_START_USD=100
SCAN_EVERY_MS=20000
DATA_DIR=data
